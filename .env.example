# DISASTEROS ENVIRONMENT CONFIGURATION
PORT=5000
NODE_ENV=development

# SUPABASE (Optional - if omitted, DisasterOS uses its high-fidelity embedded store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI PROVIDERS (Gemini, OpenAI, Anthropic)
# If left empty, DisasterOS uses its built-in rule-based explainable AI engine
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=heuristic

# EXTERNAL DATA PROVIDERS (Weather, Seismic, Routes)
OPENWEATHER_API_KEY=
OPENROUTESERVICE_API_KEY=
MAPBOX_ACCESS_TOKEN=

# NOTIFICATIONS (Twilio, Resend, FCM)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# SECURITY
JWT_SECRET=disasteros_super_secret_jwt_key_2026_secure
USE_MOCK_DATA=true

# PAYMENT GATEWAY (Razorpay)
# For Test Mode, generate keys at https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
